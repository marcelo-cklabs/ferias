---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SecaoTitulo from '../components/SecaoTitulo.astro';
import Blocos from '../components/consultoria/Blocos.astro';
import { mdInline } from '../lib/format.js';

const todas = await getCollection('consultoria');
if (todas.length === 0) throw new Error('src/content/consultoria/*.yaml ausente');
const d = todas[0].data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={`${d.titulo} · Férias CK-Labs`}>
  <main class="wrap">
    <a class="volta mono" href={`${base}/milhas`}>← VOLTAR AO PAINEL DE MILHAS</a>
    <header class="capa">
      <p class="overline mono">CONSULTORIA CONTRATADA · {d.data}</p>
      <h1>{d.titulo}</h1>
      <p class="sub">{d.subtitulo}</p>
      <p class="consultor mono">{d.consultor}</p>
      <p class="resumo" set:html={mdInline(d.resumo)} />
    </header>
    <div class="secoes">
      <section>
        <SecaoTitulo icone="📋" titulo="O plano" />
        <Blocos secoes={d.secoes} />
      </section>
      {d.conflitos.length > 0 && (
        <section>
          <SecaoTitulo icone="⚖️" titulo="Onde a consultoria diverge do painel" />
          <div class="conflitos">
            {d.conflitos.map((c: any) => (
              <article class="conflito">
                <h3>{c.titulo}</h3>
                <dl>
                  <div><dt>Consultoria</dt><dd set:html={mdInline(c.consultoria)} /></div>
                  <div><dt>Painel hoje</dt><dd set:html={mdInline(c.painel)} /></div>
                </dl>
                <p class="status" set:html={mdInline(c.status)} />
              </article>
            ))}
          </div>
        </section>
      )}
    </div>
  </main>
  <footer class="site">ÁREA PRIVADA · CK-LABS · DOCUMENTO DE REFERÊNCIA <span aria-hidden="true">📋</span></footer>
</Base>

<style>
  .volta {
    display: inline-block; font-size: .7rem; letter-spacing: .12em;
    color: #92400e; text-decoration: none; padding: 22px 0 0; min-height: 44px;
  }
  .volta:hover { text-decoration: underline; }
  .capa { padding: 8px 0 4px; }
  .overline { font-size: .64rem; letter-spacing: .24em; color: #92400e; margin: 0; }
  .capa h1 { font-family: var(--f-display); font-size: clamp(1.6rem, 5.5vw, 2.6rem); text-shadow: 3px 3px 0 var(--ambar); margin: 8px 0 6px; }
  .sub { font-weight: 600; color: var(--muted-3); margin: 0; font-size: clamp(.82rem, 2.5vw, .95rem); }
  .consultor { font-size: .68rem; letter-spacing: .1em; color: var(--muted); margin: 6px 0 0; text-transform: uppercase; }
  .resumo { font-size: .82rem; line-height: 1.6; max-width: 72ch; margin: 14px 0 0; }
  .secoes { display: grid; gap: 34px; margin-top: 34px; }
  .conflitos { display: grid; gap: 14px; }
  @media (min-width: 900px) { .conflitos { grid-template-columns: repeat(3, 1fr); } }
  .conflito { background: var(--tiquete); border-radius: 12px; box-shadow: var(--sombra-mesa); padding: 14px 18px; border-top: 3px solid var(--dourado); }
  .conflito h3 { font-size: .88rem; font-weight: 800; margin: 0 0 8px; }
  .conflito dl { margin: 0; display: grid; gap: 6px; }
  .conflito dt { font-size: .6rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .conflito dd { margin: 0; font-size: .78rem; }
  .status { font-size: .74rem; color: var(--muted-3); margin: 10px 0 0; line-height: 1.5; border-top: 1px dashed var(--linha); padding-top: 8px; }
</style>
