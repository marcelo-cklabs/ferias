---
// Renderiza as seções da consultoria (src/content/consultoria/*.yaml).
// Três formas: lista, tabela e passagem. Texto livre aceita **negrito** e *itálico*.
import { mdInline } from '../../lib/format.js';
interface Props { secoes: any[] }
const { secoes } = Astro.props;
// O schema nao cruza linhas x colunas (membro de discriminatedUnion tem de ser
// ZodObject puro). Normaliza aqui: sobra e cortado, falta vira em-dash.
const normaliza = (linha: string[], n: number) =>
  Array.from({ length: n }, (_, i) => linha[i] ?? '—');
---
<div class="blocos">
  {secoes.map((s) => (
    <section class="bloco">
      <h2><span class="ic" aria-hidden="true">{s.icone}</span>{s.titulo}</h2>
      {s.intro && <p class="intro" set:html={mdInline(s.intro)} />}

      {s.tipo === 'lista' && (
        <ul class="itens">
          {s.itens.map((i: any) => (
            <li>
              <span class="texto" set:html={mdInline(i.texto)} />
              {i.detalhe && <span class="detalhe" set:html={mdInline(i.detalhe)} />}
            </li>
          ))}
        </ul>
      )}

      {s.tipo === 'tabela' && (
        <div class="rolagem">
          <table>
            <thead>
              <tr>{s.colunas.map((c: string) => <th scope="col">{c}</th>)}</tr>
            </thead>
            <tbody>
              {s.linhas.map((l: string[]) => (
                <tr>
                  {normaliza(l, s.colunas.length).map((cel, j) => (j === 0
                    ? <th scope="row" set:html={mdInline(cel)} />
                    : <td set:html={mdInline(cel)} />))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {s.tipo === 'passagem' && (
        <div class="trechos">
          {s.trechos.map((t: any) => (
            <article class="trecho">
              <header>
                <span class="rotulo mono">{t.rotulo}</span>
                <span class="data mono">{t.data}</span>
              </header>
              <div class="rota mono">
                <div class="ponta"><b>{t.de}</b><span>{t.deHora}</span></div>
                <div class="meio"><span class="seta" aria-hidden="true">✈</span><small>{t.duracao}</small></div>
                <div class="ponta"><b>{t.para}</b><span>{t.paraHora}</span></div>
              </div>
              <p class="cia mono">{t.cia} · {t.cabine}</p>
              {t.marcadores.length > 0 && (
                <ul class="marcadores">{t.marcadores.map((m: string) => <li>{m}</li>)}</ul>
              )}
              <p class="milhas mono"><b>{t.milhas}</b>{t.total && <small>{t.total}</small>}</p>
              {t.veredito && <p class="veredito" set:html={mdInline(t.veredito)} />}
            </article>
          ))}
        </div>
      )}

      {s.nota && <p class="nota" set:html={mdInline(s.nota)} />}
    </section>
  ))}
</div>
<style>
  .blocos { display: grid; gap: 16px; }
  .bloco { background: var(--tiquete); border-radius: 12px; box-shadow: var(--sombra-mesa); padding: 16px 20px; }
  .bloco h2 { font-size: 1rem; font-weight: 800; margin: 0 0 8px; display: flex; align-items: baseline; gap: 8px; }
  .ic { font-size: .9rem; }
  .intro { font-size: .82rem; margin: 0 0 10px; max-width: 70ch; }
  .nota { font-size: .74rem; color: var(--muted-3); margin: 10px 0 0; max-width: 72ch; line-height: 1.55; }
  .itens { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .itens li { border-left: 2.5px solid var(--dourado); padding: 2px 0 2px 12px; }
  .itens .texto { display: block; font-size: .82rem; }
  .itens .detalhe { display: block; font-size: .72rem; color: var(--muted-3); margin-top: 2px; }
  .rolagem { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: .76rem; }
  th, td { text-align: left; padding: 6px 8px; border-bottom: 1px dashed var(--linha); vertical-align: top; }
  thead th { color: var(--muted); font-weight: 500; font-size: .64rem; letter-spacing: .05em; text-transform: uppercase; white-space: nowrap; }
  tbody th { font-weight: 700; }
  .trechos { display: grid; gap: 12px; }
  @media (min-width: 760px) { .trechos { grid-template-columns: 1fr 1fr; } }
  .trecho { border: 1.5px dashed var(--muted-2); border-radius: 8px; padding: 12px 14px; background: #fff; }
  .trecho header { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
  .rotulo { font-size: .64rem; letter-spacing: .14em; text-transform: uppercase; font-weight: 700; color: #92400e; }
  .data { font-size: .68rem; color: var(--muted); }
  .rota { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 8px 0 4px; }
  .ponta { display: flex; flex-direction: column; }
  .ponta b { font-size: 1.15rem; letter-spacing: .04em; }
  .ponta span { font-size: .72rem; color: var(--muted-3); }
  .meio { flex: 1; text-align: center; border-top: 1.5px dotted var(--muted-2); padding-top: 4px; }
  .meio .seta { display: block; font-size: .8rem; color: var(--dourado); }
  .meio small { font-size: .6rem; color: var(--muted); }
  .cia { font-size: .7rem; color: var(--muted-3); margin: 0; }
  .marcadores { list-style: none; display: flex; flex-wrap: wrap; gap: 4px; margin: 6px 0 0; padding: 0; }
  .marcadores li { font-size: .58rem; letter-spacing: .04em; border: 1px solid var(--linha); border-radius: 999px; padding: 2px 7px; color: var(--muted-3); }
  .milhas { margin: 8px 0 0; display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .milhas b { font-size: 1rem; font-variant-numeric: tabular-nums; }
  .milhas small { font-size: .66rem; color: var(--muted); }
  .veredito { font-size: .74rem; margin: 6px 0 0; line-height: 1.5; }
</style>
